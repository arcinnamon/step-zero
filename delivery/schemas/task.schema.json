{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://step-zero.local/schemas/task.schema.json",
  "title": "Delivery task",
  "description": "One bounded, dependency-aware unit of work. Static contract only; runtime state lives in GitHub issues/PRs, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "architecture_binding", "requirement_ids", "depends_on", "scope",
    "acceptance_criteria", "commands", "retries", "evidence"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "architecture_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_id", "revision_id"],
      "properties": {
        "architecture_id": { "$ref": "common.schema.json#/$defs/id" },
        "revision_id": { "$ref": "common.schema.json#/$defs/revisionId" }
      }
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/requirementId" }
    },
    "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "allowed_paths"],
      "properties": {
        "summary": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "allowed_paths": {
          "description": "Globs the task PR may touch. Must not overlap protected paths (checked by scripts/policy/paths.mjs).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/repoPath" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
    },
    "commands": {
      "description": "Validation commands run by independent CI. Builder-reported results are never authoritative.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "run", "timeout_seconds"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "run": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "cwd": { "$ref": "common.schema.json#/$defs/repoPath" },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
        }
      }
    },
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts"],
      "properties": { "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 } }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ci-results", "scope-check", "delivery-review", "pr-binding"] }
        }
      }
    }
  }
}
