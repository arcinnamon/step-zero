{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://step-zero.local/schemas/evidence.schema.json",
  "title": "Delivery evidence record",
  "description": "Evidence is only meaningful when published by a trusted workflow (`publisher`) and cross-checked against GitHub state. A record committed by the builder is never sufficient (G8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "architecture_binding", "attempt", "pull_request", "publisher", "results", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "$ref": "common.schema.json#/$defs/id" },
    "architecture_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_id", "revision_id", "content_digest"],
      "properties": {
        "architecture_id": { "$ref": "common.schema.json#/$defs/id" },
        "revision_id": { "$ref": "common.schema.json#/$defs/revisionId" },
        "content_digest": { "$ref": "common.schema.json#/$defs/digest" }
      }
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "head_sha"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "head_sha": { "$ref": "common.schema.json#/$defs/gitSha" }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "run_id"],
      "properties": {
        "workflow": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "run_id": { "type": "integer", "minimum": 1 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "outcome"],
        "properties": {
          "kind": { "enum": ["ci-results", "scope-check", "delivery-review", "pr-binding"] },
          "command_id": { "$ref": "common.schema.json#/$defs/id" },
          "outcome": { "enum": ["pass", "fail", "inconclusive"] },
          "log_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "advisory": { "type": "boolean", "description": "True for LLM review output, which can never satisfy a gate by itself." }
        }
      }
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" }
  }
}
